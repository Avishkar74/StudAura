# Copy to .env and fill in. Never commit .env.

# ---- Frontend (VITE_ prefix = bundled into the browser; public values only) ----
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
# `/api` behind the Ingress; http://localhost:8000 for local dev
VITE_API_BASE_URL=http://localhost:8000

# ---- Backend (secrets: never expose to the frontend) ----
# Supabase Dashboard > Settings > API > JWT Settings
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
# Supabase session pooler string. URL-encode special characters in the password
# (e.g. @ -> %40). The postgresql:// scheme is rewritten to postgresql+asyncpg://.
# docker compose overrides this with the local Postgres container.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
YOUTUBE_DATA_API_KEY=<youtube-data-api-key>
CORS_ORIGINS=http://localhost:5173
APP_ENV=local
LOG_LEVEL=INFO
