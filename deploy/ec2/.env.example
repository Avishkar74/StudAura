# Copy to deploy/ec2/.env (git-ignored) and fill in. deploy.sh copies it to the server, where the
# backend containers read it. Nothing here is committed.

# ---- Public values, baked into the frontend bundle at build time ----
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# ---- Backend (secrets) ----
APP_ENV=production
LOG_LEVEL=INFO
# Same project URL as above; the backend verifies tokens against its public keys.
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase session pooler string, password URL-encoded (@ becomes %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
YOUTUBE_DATA_API_KEY=<youtube-data-api-key>
# The site's own origin. Requests are same-origin so CORS is not exercised, but keep it exact.
CORS_ORIGINS=http://<server-ip-or-domain>
